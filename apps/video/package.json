{
  "name": "@real-estate-aim/video-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/browser-verification.mjs --mode e2e",
    "test:render": "node scripts/browser-verification.mjs --mode canonical",
    "verify:voiceover": "node scripts/browser-verification.mjs --mode voiceover",
    "verify:fixtures": "node scripts/browser-verification.mjs --mode fixtures",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "0.555.0",
    "mediabunny": "1.52.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
